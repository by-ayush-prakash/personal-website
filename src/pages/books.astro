    <div class="buyline"><a href="#">Buy</a><span class="s">|</span><a href="#">Read an excerpt</a></div>
  </div>
  <hr class="rule" />
  <div class="feature">
    <p class="kicker">November 2026</p>
    <h1 class="dtitle">The Transcendence of Money</h1>
    <p class="lede">A separate project on the future of value.</p>
    <div class="cover"><img src="/img/book-money.jpg" alt="The Transcendence of Money book cover" /></div>
    <div class="buyline"><a href="#">Pre-order</a></div>
