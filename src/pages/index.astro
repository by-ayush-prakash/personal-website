---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { themeImage, themeAlt } from '../lib/themeImage';
const pod = (await getCollection('podcast')).map((e) => ({
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  theme: e.data.theme as string | undefined,
  duration: e.data.duration as string | undefined,
  kind: 'Podcast',
  href: `/podcast/${e.data.slug}`,
}));
const wri = (await getCollection('writing')).map((e) => ({
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  theme: undefined as string | undefined,
  duration: undefined as string | undefined,
  kind: 'Essay',
  href: `/writing/${e.data.slug}`,
}));
const latest = [...pod, ...wri]
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 5)
  .map((it) => ({ ...it, img: themeImage(it.theme, 'card') }));

---

<BaseLayout
  title="Ayush Prakash"
  description="Cognition, identity, agency, and beliefs about minds. I translate the emerging research into public frameworks, policy ideas, and cultural understanding."
  ogImage="/img/book-genz.jpg"
>
  <div class="book-feature">
    <div class="cover"><img src="/img/book-genz.jpg" alt="Cover of AI for Gen Z by Ayush Prakash: a robotic hand holding a red rose against a blue fractal sky" /></div>
    <p class="kicker">Out now</p>
    <h1 class="dtitle">AI for Gen Z</h1>
    <p class="sub">What digital technology is doing to our brains, our future, and the generation coming of age inside it.</p>
    <div class="pillrow"><a class="pill pill--ghost" href="https://www.amazon.com/dp/0981182135" target="_blank" rel="noopener">Buy the book</a></div>
  </div>

  <hr class="rule" />

  <div class="statement-section">
    <h2>A generation is coming of age inside a technology nobody has finished understanding.</h2>
    <p class="lede">I research what that does to cognition, identity, agency, and beliefs about minds. The work continues through 150+ conversations and a research report publishing November 2026.</p>
    <div class="pillrow"><a class="pill" href="/research">Follow the research</a></div>
  </div>

  <hr class="rule" />

  <div class="proof"><div class="lbl">Research</div><div class="body">&ldquo;The Infinity of the Brain and the Void of the Machine&rdquo;, co-authored with Karl Friston in <a href="https://www.themontrealreview.com/Articles/the_infinity_of_the_brain_and_the_void_of_the_machine.php" target="_blank" rel="noopener" style="text-decoration:none;border-bottom:1px solid var(--hair)">The Montreal Review</a></div></div>
  <hr class="hair" />
  <div class="proof"><div class="lbl">Practice</div><div class="body">Chief of Staff at <a href="https://newsapience.com" target="_blank" rel="noopener" style="text-decoration:none;border-bottom:1px solid var(--hair)">New Sapience</a>. Non-LLM machine cognition, from the design level.</div></div>
  <hr class="rule" />

  <div style="padding-top:clamp(46px,6vw,80px)">
    <div class="sectionhead"><h2>Current Work</h2></div>

    <a class="row noimg" href="/research">
      <div>
        <div class="rt">The First AI-Native Generation</div>
        <div class="rd">A research programme on how sustained interaction with conversational AI affects cognition, identity, agency, and beliefs about minds. Report, policy brief, and framework.</div>
      </div>
      <div class="rm">Centre for Innovating the Future &middot; Nov 2026</div>
    </a>

    <div class="row noimg">
      <div>
        <div class="rt">AI Skepticism</div>
        <div class="rd">A convening series on AI claims and the evidence behind them. Canada as the first edition.</div>
      </div>
      <div class="rm">Centre for Innovating the Future &middot; In development</div>
    </div>

    <a class="row noimg" href="/books">
      <div>
        <div class="rt">The Transcendence of Money</div>
        <div class="rd">On technology, institutions, value, and the future of economic coordination.</div>
      </div>
      <div class="rm">Book &middot; Nov 2026</div>
    </a>

    <a class="row noimg" href="/podcast">
      <div>
        <div class="rt">The Ayush Prakash Podcast</div>
        <div class="rd">150+ long-form conversations with researchers, scientists, and philosophers. Episodes feed directly into published work.</div>
      </div>
      <div class="rm">Ongoing</div>
    </a>
  </div>


  <div class="sectionhead"><h2>Latest</h2><a class="r" href="/writing">View All</a></div>
  <div class="strip">
    {latest.map((it) => (
      <a class="card" href={it.href}>
        <div class="ph"><img src={it.img} alt={themeAlt(it.theme)} /></div>
        <div class="meta">{it.kind}{'duration' in it && it.duration ? ` \u00b7 ${it.duration}` : ''}</div>
        <div class="ct">{it.title}</div>
        <div class="cd">{it.description.length > 110 ? it.description.slice(0, 110).trimEnd() + '\u2026' : it.description}</div>
      </a>
    ))}
  </div>
</BaseLayout>
