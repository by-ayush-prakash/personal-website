---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { themeImage, themeAlt } from '../lib/themeImage';
const pod = (await getCollection('podcast')).map((e) => ({
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  theme: e.data.theme as string | undefined,
  duration: e.data.duration as string | undefined,
  kind: 'Podcast',
  href: `/podcast/${e.data.slug}`,
}));
const wri = (await getCollection('writing')).map((e) => ({
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  theme: undefined as string | undefined,
  duration: undefined as string | undefined,
  kind: 'Essay',
  href: `/writing/${e.data.slug}`,
}));
const latest = [...pod, ...wri]
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 5)
  .map((it) => ({ ...it, img: themeImage(it.theme, 'card') }));

---

<BaseLayout
  title="Ayush Prakash"
  description="Cognition, identity, agency, and beliefs about minds. I translate the emerging research into public frameworks, policy ideas, and cultural understanding."
  ogImage="/img/book-genz.jpg"
>
  <div class="book-feature">
    <div class="cover"><img src="/img/book-genz.jpg" alt="Cover of AI for Gen Z by Ayush Prakash: a robotic hand holding a red rose against a blue fractal sky" /></div>
    <p class="kicker">Out now</p>
    <h1 class="dtitle">AI for Gen Z</h1>
    <p class="sub">What digital technology is doing to our brains, our future, and the generation coming of age inside it.</p>
    <div class="pillrow"><a class="pill pill--ghost" href="https://www.amazon.com/dp/0981182135" target="_blank" rel="noopener">Buy the book</a></div>
  </div>

  <hr class="rule" />

  <div class="statement-section">
    <div class="s-left">
      <h2>A generation is coming of age inside a technology nobody has finished understanding.</h2>
      <div class="pillrow"><a class="pill" href="/research">Follow the research</a></div>
    </div>
    <div class="s-right">
      <p class="lede">I research what happens to cognition, identity, agency, and beliefs about minds when a generation grows up inside conversational AI. The work runs through 150+ conversations, a book, and a research report in progress.</p>
      <dl class="facts">
        <div><dt>Now</dt><dd>Chief of Staff at <a href="https://newsapience.com" target="_blank" rel="noopener">New Sapience</a>, a deterministic-AI company founded by veterans of DARPA, NASA, and the NSA.</dd></div>
        <div><dt>Research</dt><dd><a href="/research">The First AI-Native Generation</a>. A report, policy brief, and framework on how sustained interaction with conversational AI affects development. November 2026.</dd></div>
        <div><dt>Book</dt><dd><a href="/books">AI for Gen Z</a>. What digital technology is doing to our brains, our future, and the generation coming of age inside it.</dd></div>
        <div><dt>Podcast</dt><dd><a href="/podcast">150+ conversations</a> with researchers, scientists, and philosophers, including Karl Friston and Avi Loeb.</dd></div>
        <div><dt>Building</dt><dd>The Center for Innovating the Future, a Toronto strategy innovation lab, and <a href="/research">Co-Existing with AI</a>, the interview series behind the report.</dd></div>
        <div><dt>Based</dt><dd>Montreal. English and French.</dd></div>
      </dl>
    </div>
  </div>

  <hr class="rule" />


  <div style="padding-top:clamp(46px,6vw,80px)">
    <div class="sectionhead"><h2>Current Work</h2></div>

    <a class="row noimg nometa" href="/research">
      <div>
        <div class="rt">The First AI-Native Generation</div>
        <div class="rd">A research program on how sustained interaction with conversational AI affects cognition, identity, agency, and beliefs about minds. Report, policy brief, and framework.</div>
      </div>
    </a>

    <a class="row noimg nometa" href="/research">
      <div>
        <div class="rt">Co-Existing with AI</div>
        <div class="rd">The interview series behind the report. Long-form conversations with AI researchers, founders, policymakers, and skeptics, transcribed and coded. Eleven researchers to date, thirty by the end of 2026.</div>
      </div>
    </a>

    <a class="row noimg nometa" href="/books#transcendence-of-technology">
      <div>
        <div class="rt">The Transcendence of Technology</div>
        <div class="rd">On technology, what it was always for, and why the answer was never external.</div>
      </div>
    </a>

    <a class="row noimg nometa" href="/podcast">
      <div>
        <div class="rt">The Ayush Prakash Podcast</div>
        <div class="rd">150+ long-form conversations with researchers, scientists, and philosophers. Episodes feed directly into published work.</div>
      </div>
    </a>
  </div>


  <div class="sectionhead"><h2>Latest</h2><a class="r" href="/writing">View All</a></div>
  <div class="strip">
    {latest.map((it) => (
      <a class="card" href={it.href}>
        <div class="ph"><img src={it.img} alt={themeAlt(it.theme)} /></div>
        <div class="meta">{it.kind}{'duration' in it && it.duration ? ` \u00b7 ${it.duration}` : ''}</div>
        <div class="ct">{it.title}</div>
        <div class="cd">{it.description.length > 110 ? it.description.slice(0, 110).trimEnd() + '\u2026' : it.description}</div>
      </a>
    ))}
  </div>
</BaseLayout>
