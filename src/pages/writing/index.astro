---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Writing | Ayush Prakash"
  description="Published work, ordered by contribution rather than date."
  ogImage="/img/row-4.jpg"
>
  <div class="hero"><h1 class="dsub">Writing</h1><p class="lede">Published work, ordered by contribution rather than date.</p></div>
  <hr class="rule" />

  <div style="padding-top:34px">
    <div class="sectionhead"><h2>Selected</h2></div>
    <a class="row" href="https://www.themontrealreview.com/Articles/the_infinity_of_the_brain_and_the_void_of_the_machine.php" target="_blank" rel="noopener">
      <div class="thumb"><img src="/img/row-4.jpg" alt="" /></div>
      <div>
        <div class="rt">The Infinity of the Brain and the Void of the Machine</div>
        <div class="rd">With Karl Friston. What the free energy principle implies for machines that appear to have minds. Invited by The Montreal Review to develop a named series and related symposiums.</div>
      </div>
      <div class="rm">The Montreal Review</div>
    </a>
    <a class="row" href="https://www.psychologytoday.com/sg/blog/understanding-hypnosis/202511/the-risks-of-ai-and-social-media-for-the-developing-brain" target="_blank" rel="noopener">
      <div class="thumb"><img src="/img/pod-4.jpg" alt="" /></div>
      <div>
        <div class="rt">The Risks of AI and Social Media for the Developing Brain</div>
        <div class="rd">With Dr. Ran Anbar. What clinicians are seeing in young people who grew up inside algorithmic systems.</div>
      </div>
      <div class="rm">Psychology Today &middot; Nov 2025</div>
    </a>
    <a class="row" href="/books">
      <div class="thumb"><img src="/img/book-genz.jpg" alt="AI for Gen Z book cover" /></div>
      <div>
        <div class="rt">AI for Gen Z</div>
        <div class="rd">The starting point of this research program.</div>
      </div>
      <div class="rm">Book &middot; 2024</div>
    </a>
  </div>

  <div data-archive style="padding-top:clamp(50px,7vw,86px)">
    <div class="sectionhead"><h2>Archive</h2><span class="meta">{posts.length} items</span></div>
    <div class="tools">
      <input type="text" placeholder="Search writing" />
      <button type="button" data-action="surprise">Surprise me</button>
    </div>
    {posts.map((post) => (
      <a
        class="row noimg"
        href={`/writing/${post.data.slug}`}
        data-theme={post.data.theme ?? ''}
        data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}
      >
        <div>
          <div class="rt">{post.data.title}</div>
          <div class="rd">{post.data.description}</div>
        </div>
        <div class="rm">Essay{post.data.truncated ? ' · Excerpt' : ''}</div>
      </a>
    ))}
  </div>

  <script>
    import '../../scripts/archiveFilters';
  </script>
</BaseLayout>
