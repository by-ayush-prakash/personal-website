---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const episodes = (await getCollection('podcast')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Podcast | Ayush Prakash"
  description="150+ conversations with researchers, scientists, and philosophers."
>
  <div class="hero">
    <h1 class="dsub" style="max-width:22ch">150+ conversations with researchers, scientists, and philosophers.</h1>
    <nav class="podcast-platforms" aria-label="Listen to the podcast">
      <a href="https://open.spotify.com/show/1ILhje5HSua1FEOlTyFAhG" target="_blank" rel="noopener" aria-label="Listen on Spotify" title="Spotify">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1DB954"/><path d="M5.4 9.2c4.3-1.3 9.5-.9 13.2 1.4M6.4 12.3c3.5-1 7.7-.6 10.8 1.2m-9.8 1.8c2.7-.7 5.8-.4 8.2.9" fill="none" stroke="#111" stroke-linecap="round" stroke-width="1.7"/></svg>
      </a>
      <a href="https://www.youtube.com/@ayushprakashofficial" target="_blank" rel="noopener" aria-label="Watch on YouTube" title="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="5" fill="#FF0033"/><path d="m10 8 6 4-6 4z" fill="#fff"/></svg>
      </a>
      <a href="https://apple.co/3qXL37W" target="_blank" rel="noopener" aria-label="Listen on Apple Podcasts" title="Apple Podcasts">
        <svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="apple-podcasts-gradient" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#C844FC"/><stop offset="1" stop-color="#7027D8"/></linearGradient></defs><circle cx="12" cy="12" r="12" fill="url(#apple-podcasts-gradient)"/><g fill="none" stroke="#fff" stroke-linecap="round" stroke-width="1.5"><path d="M9.4 7.2a4.2 4.2 0 0 1 5.2 0M7.2 5a7.2 7.2 0 0 1 9.6 0M5.2 15a7.8 7.8 0 0 1 .2-8.4m13.4 0a7.8 7.8 0 0 1 .2 8.4M7.2 17a7.2 7.2 0 0 0 9.6 0"/><path d="M10.2 12.5 11 17a1 1 0 0 0 2 0l.8-4.5a1.9 1.9 0 1 0-3.6 0Z" fill="#fff" stroke="none"/></g></svg>
      </a>
    </nav>
  </div>
  <div class="podcast-archive" data-archive style="padding-top:clamp(50px,7vw,86px)">
    <div class="sectionhead"><h2>Episodes</h2><span class="meta" role="status" aria-live="polite" data-count></span></div>
    <div class="tools">
      <input placeholder="Search episodes" type="search" aria-label="Search episodes" />
      <button type="button" data-action="surprise">Surprise me</button>
    </div>
    {episodes.map((ep) => (
      <a
        class="row"
        href={`/podcast/${ep.data.slug}`}
        data-search={`${ep.data.title} ${ep.data.description}`.toLowerCase()}
      >
        <div class="rt">{ep.data.title}</div>
        <div class="rm">Podcast{ep.data.duration ? ` · ${ep.data.duration}` : ''}</div>
      </a>
    ))}
  </div>

  <script>
    import '../../scripts/archiveFilters';
  </script>
</BaseLayout>


<style>
  .podcast-archive > .row:first-of-type {
    border-top: 0;
  }

  .podcast-platforms {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 26px;
  }

  .podcast-platforms a {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--hair);
    border-radius: 50%;
    transition: transform .15s ease, border-color .15s ease;
  }

  .podcast-platforms a:hover {
    transform: translateY(-2px);
    border-color: var(--ink);
  }

  .podcast-platforms a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .podcast-platforms svg {
    display: block;
    width: 22px;
    height: 22px;
  }
</style>
