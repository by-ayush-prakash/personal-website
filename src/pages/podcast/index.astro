---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { THEMES } from '../../content.config';
import { themeImage, themeAlt } from '../../lib/themeImage';

const episodes = (await getCollection('podcast')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = episodes.filter((ep) => ep.data.featured);
const tagged = episodes.filter((ep) => ep.data.theme);
---

<BaseLayout
  title="Podcast | Ayush Prakash"
  description="150+ conversations with researchers, scientists, and philosophers. The podcast is a research instrument."
  ogImage="/img/theme-cognition-wide.jpg"
>
  <div class="hero">
    <h1 class="dsub" style="max-width:22ch">150+ conversations with researchers, scientists, and philosophers.</h1>
  </div>
  <hr class="rule" />

  {featured.length > 0 && (
    <div style="padding-top:38px">
      <div class="sectionhead"><h2>Start Here</h2><span class="meta">Conversations that inform the report &rarr;</span></div>
      <div class="strip">
        {featured.map((ep) => (
          <a class="card" href={`/podcast/${ep.data.slug}`}>
            <div class="ph"><img src={themeImage(ep.data.theme, 'card')} alt={themeAlt(ep.data.theme)} loading="lazy" /></div>
            <div class="meta">{ep.data.theme ?? 'Podcast'} &middot; {ep.data.duration ?? ''}</div>
            <div class="ct">{ep.data.title}</div>
            <div class="cd">{ep.data.description}</div>
          </a>
        ))}
      </div>
    </div>
  )}

  <div data-archive style="padding-top:clamp(50px,7vw,86px)">
    <div class="sectionhead"><h2>Episodes</h2><span class="meta" data-count></span></div>
    <div class="filters">
      <button class="on" data-theme="all">All</button>
      {THEMES.map((theme) => <button data-theme={theme}>{theme}</button>)}
    </div>
    <p class="meta" style="padding-top:14px;max-width:62ch">Episodes tagged to the five research themes are shown by default. The full archive back to 2021 is one click away, and search always covers all of it.</p>
    <div class="tools">
      <input type="text" placeholder="Search episodes" />
      <button type="button" data-action="show-all">Show the full archive</button>
      <button type="button" data-action="surprise">Surprise me</button>
    </div>
    {episodes.map((ep) => (
      <a
        class="row"
        href={`/podcast/${ep.data.slug}`}
        data-theme={ep.data.theme ?? ''}
        data-untagged={ep.data.theme ? undefined : 'true'}
        data-search={`${ep.data.title} ${ep.data.description}`.toLowerCase()}
      >
        <div class="thumb"><img src={themeImage(ep.data.theme, 'sq')} alt={themeAlt(ep.data.theme)} loading="lazy" /></div>
        <div>
          <div class="rt">{ep.data.title}</div>
          <div class="rd">{ep.data.description}</div>
        </div>
        <div class="rm">{ep.data.theme ?? 'Podcast'} &middot; {ep.data.duration ?? ''}</div>
      </a>
    ))}
  </div>

  <script>
    import '../../scripts/archiveFilters';
  </script>
</BaseLayout>
