---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SEOHead title={title} description={description} ogImage={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ayush Prakash",
      "url": "https://ayushprakash.com",
      "jobTitle": "Chief of Staff",
      "worksFor": { "@type": "Organization", "name": "New Sapience" },
      "address": { "@type": "PostalAddress", "addressLocality": "Montreal", "addressCountry": "CA" },
      "knowsLanguage": ["en", "fr"],
      "identifier": "https://orcid.org/0009-0003-5287-9694",
      "sameAs": [
        "https://orcid.org/0009-0003-5287-9694",
        "https://www.linkedin.com/in/prakash-ayush/",
        "https://ayushprakash.substack.com",
        "https://www.youtube.com/@ayushprakashofficial"
      ]
    })} />
  </head>
  <body>
    <div class="wrap">
      <Header />
      <hr class="rule" />
      <slot />
      <Footer />
    </div>
  </body>
</html>
