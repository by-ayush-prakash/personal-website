---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/writing', label: 'Writing' },
  { href: '/books', label: 'Books' },
  { href: '/about', label: 'About' },
];

// Normalise trailing slashes, and treat /podcast/<slug> as "Podcast" being active.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site">
  <div class="mastrow">
    <a href="/" class="wordmark">Ayush Prakash</a>
    <nav class="main">
      {navItems.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'on' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
